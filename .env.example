# English Reader 설정 파일 — 이 파일은 남에게 공유하지 마세요.

# Claude API 키 (= 뒤에 붙여넣기). 비워두면 무료 사전 모드로 동작해요.
ANTHROPIC_API_KEY=

# 사전 모델. 기본값 claude-haiku-5-5 (조회 1회 ≈0.4원)
# 더 자세한 설명이 필요하면 claude-sonnet-5-5 / claude-opus-5-5
CLAUDE_MODEL=claude-haiku-5-5

# 배포용 로그인 비밀번호 (로컬에서는 비워두면 로그인 없음)
APP_PASSWORD=

# (선택) DeepL Free 키 — 무료 모드 번역 품질 향상 (월 50만 자 무료)
DEEPL_API_KEY=
